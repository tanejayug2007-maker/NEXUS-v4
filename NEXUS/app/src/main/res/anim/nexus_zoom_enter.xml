<?xml version="1.0" encoding="utf-8"?>
<!-- Cybernetic Zoom: incoming app rushes forward out of the launcher plane. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="260">
    <scale android:fromXScale="0.72" android:toXScale="1.0"
        android:fromYScale="0.72" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="180" />
</set>
