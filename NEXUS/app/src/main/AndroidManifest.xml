<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Launcher essentials -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Shell commands `timer` / `alarm` hand off to the clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Normal permission: lets NEXUS open the real system notification shade / Quick Settings -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Status + control center (read-only state, no privileged control) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Special-access permission the user grants in Settings; used for brightness + auto-rotate -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Optional NEXUS lock layer (shown over the secure lock screen when the screen turns on) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Optional: NEXUS as default phone app (custom call screens). Telephony is not required to install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional calendar widget -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Optional weather module (Open-Meteo, no account) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".NexusApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexus"
        tools:targetApi="34">

        <!-- The real HOME activity. Not in the app drawer; reached with the Home button. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|mcc|mnc|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Nexus.Home"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
        </activity>

        <!-- Customization Studio. Has a normal app icon so it can be opened from ANY launcher,
             which is how you set NEXUS as default the first time. -->
        <activity
            android:name=".ui.settings.StudioActivity"
            android:exported="true"
            android:label="@string/studio_label"
            android:taskAffinity="com.nexus.launcher.studio"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- NEXUS Calculator: standalone app with its own icon and task. APP_CALCULATOR only makes it
             selectable as "a calculator"; it does not change any default or role. -->
        <activity
            android:name=".apps.calculator.CalculatorActivity"
            android:exported="true"
            android:icon="@mipmap/ic_calculator"
            android:roundIcon="@mipmap/ic_calculator"
            android:label="@string/calculator_label"
            android:taskAffinity="com.nexus.launcher.calculator"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CALCULATOR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- NEXUS Settings Hub: NEXUS-styled front door to the REAL Settings pages (not a replacement) -->
        <activity
            android:name=".apps.settingshub.SettingsHubActivity"
            android:exported="true"
            android:icon="@mipmap/ic_settings_hub"
            android:roundIcon="@mipmap/ic_settings_hub"
            android:label="@string/settings_hub_label"
            android:taskAffinity="com.nexus.launcher.settingshub"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tiles: real tiles in the real QS panel (public TileService API).
             BIND_QUICK_SETTINGS_TILE means only the system can bind them. -->
        <service
            android:name=".system.tiles.NexusTorchTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_torch"
            android:label="@string/tile_torch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".system.tiles.NexusEcoTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_eco"
            android:label="@string/tile_eco"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".system.tiles.NexusCalculatorTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_calc"
            android:label="@string/tile_calc"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".system.tiles.NexusSettingsHubTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_settings"
            android:label="@string/tile_hub"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".system.tiles.NexusShellTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_shell"
            android:label="@string/tile_shell"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- NEXUS lock layer: a skin in front of Android's secure keyguard, never a replacement -->
        <activity
            android:name=".lock.LockLayerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.nexus.launcher.lock"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Nexus.Home" />

        <!-- Always-on face as an Android screen saver (while charging / docked) -->
        <service
            android:name=".lock.NexusDreamService"
            android:exported="true"
            android:label="@string/dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <!-- Calls: only active if the user makes NEXUS the default phone app -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.nexus.launcher.call"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Nexus.Home" />

        <activity
            android:name=".call.DialerActivity"
            android:exported="true"
            android:label="@string/dialer_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.nexus.launcher.dialer"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <service
            android:name=".call.NexusInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Reads notifications for the NEXUS feed, badges and media controls (user must enable). -->
        <service
            android:name=".notifications.NexusNotificationService"
            android:exported="true"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional helper: lock screen on double-tap, open system shade/QS reliably. -->
        <service
            android:name=".system.NexusAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
